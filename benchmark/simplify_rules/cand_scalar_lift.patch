+# Candidate scalar_lift: a scalar under a linear wrapper moves out of it, `D₋ₓ(c * u) ->
+# c * D₋ₓ(u)`, where it meets the nested-scale fold and the inner-product lift. Decided by the
+# node type alone (`OperatorScale`), with the coefficient carried over untouched.
+@inline _lift_wrapper_scalar(op, ::Any) = op
+@inline function _lift_wrapper_scalar(op, inner::OperatorScale)
+    return simplify_ast(OperatorScale(inner.scalar, simplify_ast(_rewrap_inner(op, inner.inner_op))))
+end
