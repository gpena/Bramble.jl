# Ingore MacOS files
.DS_Store
.vscode
Bramble.code-workspace

# Files generated by invoking Julia with --code-coverage
*.jl.cov
*.jl.*.cov
*.csv

# Files generated by invoking Julia with --track-allocation
*.jl.mem

# Build artifacts for creating documentation generated by the Documenter package
docs/build/

# Markdown generated from the Literate example scripts by docs/make.jl. The script next to
# each one is the source; committing the generated page too would give a second copy to keep
# in step, which is the duplication Literate removed (gpena/Bramble.jl#117).
docs/src/examples/poisson_linear.md
docs/src/examples/poisson_nonlinear.md
docs/src/examples/convection_diffusion_linear.md
docs/src/examples/coupled_reaction_diffusion.md
docs/src/examples/elasticity_3d.md
docs/src/examples/heat_equation.md
docs/src/examples/amg_preconditioning.md
docs/src/examples/inverse_diffusion.md
docs/src/examples/wave_equation_2d.md
docs/src/examples/point_sources_flux.md
docs/src/examples/transient_inplace.md
docs/src/examples/boundary_layer_graded.md
docs/src/examples/transient_inverse_problem.md
docs/src/examples/memory_scaling.md

# LaTeX build artifacts from the manual. Scoped to manual/ rather than global, so a .tex
# file kept deliberately elsewhere — a figure source, say — is unaffected.
#
# The sources are manual/*.tex, manual/chapters/, manual/preamble.tex, manual/assets/ and
# build.sh; everything below is regenerated by running it.
manual/*

# The latexmk configuration itself, at the root as well as inside manual/. It only exists
# to build the manual, and everything to do with the manual stays out of version control.
# No leading slash, so it matches at any depth.
.latexmkrc

# OneDrive sync conflicts. The repository lives inside a OneDrive folder, and when the
# same path is written on two machines OneDrive keeps both by appending a space and a
# number to the name: `docs/build 2/`, `assets 2/`, and so on. They are duplicates of
# ignored build output but the ignore rules above do not match the renamed form, so
# `git add -A` would commit them.
*\ [0-9]
*\ [0-9]/
*\ [0-9].*
*\ [0-9][0-9]
*\ [0-9][0-9]/
*\ [0-9][0-9].*

# File generated by Pkg, the package manager, based on a corresponding Project.toml
# It records a fixed state of all packages used by the project. As such, it should not be
# committed for packages, but should be committed for applications that require a static
# environment.
Manifest.toml
*.mp4

# other stuff
# Scratch benchmarking stays ignored, but the committed regression suite does not: an
# uncommitted benchmark suite cannot be a baseline for anyone else. The directory is
# excluded by its contents rather than as a whole, since git does not descend into an
# excluded directory and the negations below would never be reached.
benchmark/*
!benchmark/benchmarks.jl
!benchmark/Project.toml
# v3.3.0 standalone measurement scripts (gpena/Bramble.jl#185 #217 #175 #190)
!benchmark/operator_matrices.jl
!benchmark/finch_assembly.jl
!benchmark/backends.jl
!benchmark/polyester_crossover.jl
!benchmark/baselines/
!benchmark/baselines/*.json
research/
.agents/
.claude/
.caliper/
graphify-out/
LocalPreferences.toml

# The manual is written and built outside version control, by request.
# This covers its sources, its LaTeX build products and the design preview.
manual/
presentation/
docs/manual_design_preview.html

# Agent instructions and the standards index they point into, kept local alongside
# .agents/ and .claude/ above. Both are about *working on* the package, and both index
# into .agents/skills/, which is itself untracked — tracking a map to files nobody else
# has would only mislead. CONTEXT.md stays tracked: it is the domain vocabulary, and that
# is about the package itself.
CLAUDE.md
STANDARDS.md
DOCUMENTATION_PLAN.md
TYPE_INSTABILITIES_REVIEW.md

# Supposition's example database. Every `@check function check_<name>(...)` that runs writes
# a binary cache beside the test file, named `check_<name>(<argtypes>)_check_<name>` with no
# extension, so it shows up untracked after any local property-test run. It is regenerable
# and machine-specific; there is nothing to share.
check_*_check_*
