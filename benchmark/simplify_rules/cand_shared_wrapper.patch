@@ -272,9 +272,71 @@ function simplify_ast(op::OperatorAdd)
     _is_zero_op(left) && return right
     _is_zero_op(right) && return left
 
+    # Candidate shared_wrapper: of two products sharing one argument whose other arguments
+    # are one wrapper over two operands, factor the shared argument and merge the wrapper,
+    # `⟨Au, W(x)⟩ + ⟨Au, W(y)⟩ -> ⟨Au, W(x + y)⟩` (rule 7's shape, restricted to a shared
+    # wrapper). `left` is already factored, so a left-deep sum reaches every match.
+    merged = _absorb(left, right)
+    merged === nothing || return merged
